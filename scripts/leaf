#!/bin/sh
# Opens files in Leaf from a terminal or a coding agent:
#   leaf notes.md            open a file
#   leaf src/main.rs:42      open at line 42
#   leaf ~/Projects/site     add a folder to the sidebar
#   leaf                     just bring Leaf up
if [ $# -eq 0 ]; then
  exec open -b io.github.shhossain.leaf
fi
for arg in "$@"; do
  line=""
  path="$arg"
  # file:LINE or file:LINE:COL, unless a file with that exact name exists
  if [ ! -e "$path" ]; then
    case "$path" in
      *:[0-9]*:[0-9]*) line="${path%:*}"; line="${line##*:}"; path="${path%:*:*}" ;;
      *:[0-9]*) line="${path##*:}"; path="${path%:*}" ;;
    esac
  fi
  case "$path" in
    /*) ;;
    *) path="$PWD/$path" ;;
  esac
  encoded=$(printf '%s' "$path" | perl -pe 's/([^A-Za-z0-9\/._~-])/sprintf("%%%02X", ord($1))/ge')
  url="leaf://open?path=$encoded"
  [ -n "$line" ] && url="$url&line=$line"
  open "$url"
done
